# ===========================================
# Secure Portfolio & Blog — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# --- Authentication ---
# Generate a strong JWT secret (64+ random characters):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-generated-secret-here

# JWT token expiration (default: 7d)
# JWT_EXPIRES_IN=7d

# Admin credentials (change before deploying!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# --- Database ---
# Path to SQLite database file (relative to project root)
# DATABASE_PATH=./data/portfolio.db

# --- Security ---
# Set to 'true' if behind a trusted reverse proxy (e.g., Vercel, Cloudflare)
# TRUSTED_PROXY=false

# Comma-separated list of allowed CORS origins
# ALLOWED_ORIGINS=https://yourdomain.com

# --- Rate Limiting ---
# Rate limit window in milliseconds (default: 15 minutes = 900000)
# RATE_LIMIT_WINDOW_MS=900000

# Max requests per window (default: 100)
# RATE_LIMIT_MAX_REQUESTS=100

# --- Cron ---
# Secret for authenticating cron job requests
# CRON_SECRET=your-cron-secret-here

# --- Deployment ---
# Production site URL (used for Open Graph, SEO, etc.)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
